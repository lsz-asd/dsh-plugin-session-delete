{
  "name": "@huanlin/dsh-plugin-session-delete",
  "version": "0.5.0",
  "description": "Manage archived DeepSeek Harness sessions from a sidebar archive manager: list, restore, or permanently delete them, alongside confirmed archive and danger actions. Works in web and the desktop client alike.",
  "type": "module",
  "scripts": {
    "build": "bash scripts/build.sh"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["dsh-plugin"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsz-asd/dsh-plugin-session-delete.git"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  }
}
